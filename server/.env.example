# PostgreSQL connection string
DATABASE_URL="postgresql://ferrolink:change-me@localhost:5432/ferrolink?schema=public"
# Secret aléatoire d'au moins 32 caractères. En production, sans lui, une clé temporaire
# est utilisée et l'équipe est déconnectée à chaque redémarrage.
SESSION_SECRET="replace-with-a-long-random-secret"
PORT=4000
FRONTEND_URL="http://localhost:5173"
NODE_ENV="development"
PRIVATE_UPLOAD_DIR="./private-uploads"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="******"
SMTP_PASS="replace-with-your-smtp-password"
SMTP_FROM="ferroLink <noreply@example.com>"
# Boîte qui reçoit les alertes (candidatures, messages). Vide : tous les comptes de l'équipe.
NOTIFICATION_EMAIL=""
# Envois autorisés par heure et par adresse IP sur les formulaires publics
PUBLIC_FORM_RATE_LIMIT=10
# Mettre à "off" pour ne pas relire les flux d'actualités
NEWS_REFRESH="on"
