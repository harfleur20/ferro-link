generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum UserRole {
  CANDIDATE
  RECRUITER
  RECRUITMENT_ADMIN
  SUPER_ADMIN
}
enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}
enum ApplicationStatus {
  RECEIVED
  UNDER_REVIEW
  INTERVIEW
  ACCEPTED
  REJECTED
}
model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String?
  googleId String? @unique
  fullName String
  avatarUrl String?
  role UserRole @default(CANDIDATE)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  applications Application[] @relation("CandidateApplications")
  reviewedApps Application[] @relation("ApplicationReviewer")
  createdJobs Job[] @relation("JobCreator")
  notifications Notification[]
  @@index([role])
}
model Job {
  id String @id @default(cuid())
  title String
  slug String @unique
  category String?
  department String?
  location String?
  contractType String?
  experience String?
  salary String?
  imageUrl String?
  imageAlt String?
  description String @db.Text
  missions String[] @default([])
  requirements String? @db.Text
  status JobStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdById String
  createdBy User @relation("JobCreator", fields: [createdById], references: [id])
  applications Application[]
  @@index([status, publishedAt])
}
model Application {
  id String @id @default(cuid())
  candidateId String?
  applicantName String
  applicantEmail String
  applicantPhone String
  applicantCity String?
  experience String?
  availability String?
  consentAt DateTime
  jobId String?
  jobTitle String @default("Candidature")
  status ApplicationStatus @default(RECEIVED)
  coverLetter String? @db.Text
  resumeUrl String?
  letterFile String?
  reviewerNote String? @db.Text
  reviewedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  candidate User? @relation("CandidateApplications", fields: [candidateId], references: [id], onDelete: SetNull)
  job Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  reviewedBy User? @relation("ApplicationReviewer", fields: [reviewedById], references: [id])
  @@index([status, createdAt])
  @@index([candidateId, createdAt])
}
model Notification {
  id String @id @default(cuid())
  userId String
  title String
  message String
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}
model ContactMessage {
  id String @id @default(cuid())
  name String
  email String
  subject String
  message String @db.Text
  readAt DateTime?
  createdAt DateTime @default(now())
  @@index([createdAt])
}
model NewsArticle {
  id String @id @default(cuid())
  slug String @unique
  title String
  excerpt String? @db.Text
  imageUrl String?
  sourceName String
  sourceUrl String @unique
  language String
  publishedAt DateTime
  fetchedAt DateTime @default(now())
  hidden Boolean @default(false)
  @@index([hidden, publishedAt])
}
model Session {
  id String @id @default(cuid())
  sid String @unique
  data String @db.Text
  expiresAt DateTime
  @@index([expiresAt])
}
model SiteSettings {
  id String @id @default("main")
  value Json
  updatedById String?
  updatedAt DateTime @updatedAt
}