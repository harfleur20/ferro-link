---
import "../styles/global.css";

const expertiseAreas = [
  {
    number: "01",
    icon: "signal",
    title: "Signalisation & systèmes",
    description:
      "Signalisation ferroviaire, CBTC et systèmes de contrôle : nous aidons à concevoir des réseaux sûrs et performants.",
    tag: "Signalisation · CBTC",
  },
  {
    number: "02",
    icon: "track",
    title: "Voie & génie civil",
    description:
      "De l’étude à la réalisation, nous accompagnons vos projets d’infrastructure et de voie ferrée.",
    tag: "Infrastructure · Voie",
  },
  {
    number: "03",
    icon: "train",
    title: "Matériel roulant",
    description:
      "Une expertise au service de la conception, de la maintenance et de la disponibilité de vos matériels.",
    tag: "Trains · Maintenance",
  },
  {
    number: "04",
    icon: "energy",
    title: "Énergie & télécoms",
    description:
      "Courants forts, courants faibles et télécommunications : des systèmes connectés, pensés dans leur ensemble.",
    tag: "Énergie · Télécoms",
  },
];

const partners = [
  { src: "/images/partner-1.png", alt: "Egis" },
  { src: "/images/partner-2.png", alt: "Colas Rail" },
  { src: "/images/partner-3.jpeg", alt: "INEO, une marque d'Equans" },
  { src: "/images/partner-4.jpeg", alt: "Setec" },
  { src: "/images/partner-5.png", alt: "RATP" },
  { src: "/images/partner-6.png", alt: "Alstom" },
];
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="ferroLink accompagne les acteurs du ferroviaire dans leurs projets d'infrastructure, de signalisation, de matériel roulant et d'énergie."
    />
    <meta name="theme-color" content="#17243b" />
    <title>ferroLink — Le conseil ferroviaire en mouvement</title>
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>

    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="#accueil" aria-label="ferroLink, accueil">
          <img src="/images/ferrolink-logo.png" alt="ferroLink" width="995" height="157" />
        </a>
        <button
          class="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="main-navigation"
          aria-label="Ouvrir le menu"
        >
          <span></span>
          <span></span>
        </button>
        <nav class="main-navigation" id="main-navigation" aria-label="Navigation principale">
          <a href="#expertises">Nos expertises</a>
          <a href="#approche">Notre approche</a>
          <a href="#references">Références</a>
          <a class="button button-small" href="#contact">Parlons de votre projet <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>

    <main id="contenu">
      <section class="hero" id="accueil" aria-labelledby="hero-title">
        <iframe
          class="hero-video"
          src="https://www.youtube.com/embed/htTd2MiW4KY?autoplay=1&amp;mute=1&amp;controls=0&amp;loop=1&amp;playlist=htTd2MiW4KY&amp;playsinline=1&amp;start=1&amp;end=30&amp;rel=0"
          title="Train ferroviaire en mouvement"
          allow="autoplay; encrypted-media; picture-in-picture"
          referrerpolicy="strict-origin-when-cross-origin"
          tabindex="-1"
          aria-hidden="true"
        ></iframe>
        <div class="hero-overlay"></div>
        <div class="hero-content page-width">
          <p class="eyebrow eyebrow-light"><span></span> Conseil & ingénierie ferroviaire</p>
          <h1 id="hero-title">Le ferroviaire<br />en mouvement.</h1>
          <p class="hero-lead">
            Nous connectons les talents et les infrastructures pour faire avancer vos projets,
            du premier tracé à la mise en service.
          </p>
          <a class="button button-lime" href="#expertises">
            Découvrir nos expertises <span aria-hidden="true">↘</span>
          </a>
        </div>
        <div class="hero-caption"><span>01</span> Imaginer. Relier. Faire avancer.</div>
        <a class="scroll-cue" href="#intro" aria-label="Défiler vers la suite"><span></span></a>
      </section>

      <div class="capability-strip" aria-label="Notre accompagnement">
        <div class="page-width capability-inner">
          <span>Une expertise ferroviaire de terrain</span>
          <span class="capability-divider" aria-hidden="true"></span>
          <span>Du conseil à la mise en service</span>
          <span class="capability-divider" aria-hidden="true"></span>
          <span>Des équipes au cœur de vos projets</span>
        </div>
      </div>

      <section class="intro section page-width" id="intro">
        <div class="section-kicker"><span>01</span> À propos de ferroLink</div>
        <div class="intro-grid">
          <h2>Le bon lien entre<br />vos ambitions et le terrain.</h2>
          <div class="intro-copy">
            <p class="lead">
              Le ferroviaire est un écosystème exigeant. ferroLink rassemble les compétences
              qui le font avancer.
            </p>
            <p>
              Société de conseil spécialisée dans l'industrie ferroviaire, nous accompagnons
              les grands comptes et les industriels à chaque étape de leurs projets : études,
              industrialisation, production, exploitation et maintenance.
            </p>
            <a class="text-link" href="#approche">Découvrir notre approche <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

      <section class="expertise section" id="expertises">
        <div class="page-width">
          <div class="section-heading">
            <div>
              <div class="section-kicker"><span>02</span> Nos domaines d'intervention</div>
              <h2>Une vision complète<br />de vos enjeux ferroviaires.</h2>
            </div>
            <p>
              Des expertises complémentaires, mobilisées avec agilité selon les besoins et
              l'ambition de chaque projet.
            </p>
          </div>
          <div class="expertise-grid">
            {expertiseAreas.map((area) => (
              <article class="expertise-card">
                <span class="card-number">{area.number}</span>
                <div class="card-mark" aria-hidden="true">
                  {area.icon === "signal" && (
                    <svg viewBox="0 0 48 48" fill="none">
                      <path d="M24 28v14M19 42h10" />
                      <rect x="14" y="5" width="20" height="25" rx="3" />
                      <circle cx="24" cy="13" r="3" />
                      <circle cx="24" cy="23" r="3" />
                      <path d="M34 10h6M34 25h6" />
                    </svg>
                  )}
                  {area.icon === "track" && (
                    <svg viewBox="0 0 48 48" fill="none">
                      <path d="M17 5 12 43M31 5l5 38M14 13h20M13 21h22M12 29h24M11 37h26" />
                      <path d="M19 5h10" />
                    </svg>
                  )}
                  {area.icon === "train" && (
                    <svg viewBox="0 0 48 48" fill="none">
                      <rect x="10" y="5" width="28" height="32" rx="6" />
                      <path d="M10 24h28M16 42l5-5M32 42l-5-5M18 42h12" />
                      <path d="M17 12h14v7H17z" />
                      <circle cx="18" cy="30" r="2" fill="currentColor" />
                      <circle cx="30" cy="30" r="2" fill="currentColor" />
                    </svg>
                  )}
                  {area.icon === "energy" && (
                    <svg viewBox="0 0 48 48" fill="none">
                      <path d="M10 43 20 5M38 43 28 5M15 24h18M17 16h14M13 32h22M24 5v38" />
                      <path d="M19 5h10M21 11h6" />
                      <path d="m26 17-6 10h5l-3 7 8-11h-5l3-6" fill="currentColor" stroke="none" />
                    </svg>
                  )}
                </div>
                <h3>{area.title}</h3>
                <p>{area.description}</p>
                <span class="card-tag">{area.tag}</span>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="approach section page-width" id="approche">
        <div class="approach-heading">
          <div class="section-kicker"><span>03</span> Notre approche</div>
          <h2>Du premier échange<br />au dernier essai.</h2>
          <p>
            Une présence à chaque étape pour sécuriser les décisions, fluidifier les interfaces
            et transformer les objectifs en résultats concrets.
          </p>
          <a class="text-link" href="#contact">Construisons la suite ensemble <span aria-hidden="true">↗</span></a>
        </div>
        <div class="approach-steps">
          <article class="approach-step">
            <span class="step-index">01 / Comprendre</span>
            <h3>Poser le bon diagnostic</h3>
            <p>Écouter vos équipes, analyser les contraintes et clarifier les priorités.</p>
          </article>
          <article class="approach-step">
            <span class="step-index">02 / Construire</span>
            <h3>Mobiliser les compétences</h3>
            <p>Réunir les expertises adaptées et les intégrer au plus près du projet.</p>
          </article>
          <article class="approach-step">
            <span class="step-index">03 / Faire avancer</span>
            <h3>Accompagner dans la durée</h3>
            <p>Suivre les actions, anticiper les enjeux et viser une mise en service maîtrisée.</p>
          </article>
        </div>
      </section>

      <section class="references section" id="references">
        <div class="page-width">
          <div class="references-heading">
            <div>
              <div class="section-kicker"><span>04</span> Ils nous font confiance</div>
              <h2>Le ferroviaire se construit ensemble.</h2>
            </div>
            <p>Des partenaires engagés au service des infrastructures de demain.</p>
          </div>
          <div class="partner-grid">
            {partners.map((partner) => (
              <div class="partner">
                <img src={partner.src} alt={partner.alt} loading="lazy" />
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="contact section page-width" id="contact">
        <div class="contact-panel">
          <div class="contact-content">
            <div class="section-kicker section-kicker-light"><span>05</span> Et si on faisait avancer vos projets ?</div>
            <h2>Chaque grand projet<br />commence par un échange.</h2>
            <p>Parlons de vos enjeux ferroviaires et des compétences qu'il vous faut.</p>
            <a class="button button-lime" href="mailto:gregory.aline@avenirferro.com">
              Contactez ferroLink <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div class="contact-orbit" aria-hidden="true">
            <div class="orbit orbit-one"></div>
            <div class="orbit orbit-two"></div>
            <div class="orbit-core"><span>FL</span></div>
            <span class="orbit-node"></span>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="page-width footer-main">
        <a class="footer-brand" href="#accueil" aria-label="ferroLink, retour à l'accueil">
          <span class="footer-mark" aria-hidden="true">F<span>L</span></span>
          <span class="footer-name">ferro<span>Link</span></span>
        </a>
        <p class="footer-tagline">Connecter les talents<br />& les infrastructures ferroviaires.</p>
        <nav class="footer-navigation" aria-label="Navigation de pied de page">
          <a href="#expertises">Expertises</a>
          <a href="#approche">Notre approche</a>
          <a href="#references">Références</a>
        </nav>
        <div class="footer-contact">
          <span>Un projet en tête ?</span>
          <a href="mailto:gregory.aline@avenirferro.com">Écrivez-nous <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="page-width footer-bottom">
        <span>© {new Date().getFullYear()} ferroLink. Tous droits réservés.</span>
        <a href="#accueil">Retour en haut ↑</a>
      </div>
    </footer>

    <script>
      const menuToggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const navigation = document.querySelector<HTMLElement>(".main-navigation");

      menuToggle?.addEventListener("click", () => {
        const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
        menuToggle.setAttribute("aria-expanded", String(!isOpen));
        menuToggle.setAttribute("aria-label", isOpen ? "Ouvrir le menu" : "Fermer le menu");
        navigation?.classList.toggle("is-open", !isOpen);
      });

      navigation?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          menuToggle?.setAttribute("aria-expanded", "false");
          menuToggle?.setAttribute("aria-label", "Ouvrir le menu");
          navigation.classList.remove("is-open");
        });
      });
    </script>
  </body>
</html>
